---
import Base from "../layouts/Base.astro";
---

<Base title="Halaman Tidak Ditemukan — Langit yang Sama">
  <div class="stars" aria-hidden="true"></div>
  <main class="nf">
    <p class="kicker">404</p>
    <h1 class="nf-title">Bintang ini tidak ada di langit kami</h1>
    <p class="nf-text">
      Tautan yang kamu ikuti mungkin salah ketik, atau undangannya belum diterbitkan.
    </p>
    <a class="btn btn--solid" href="/">Kembali ke Beranda</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 2rem;
    gap: 1.2rem;
  }
  .nf-title {
    font-family: var(--font-display);
    font-style: italic; font-weight: 300;
    font-size: var(--step-3);
    max-width: 20ch;
  }
  .nf-text { color: var(--ivory-dim); max-width: 44ch; }
</style>