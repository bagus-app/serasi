---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const weddings = await getCollection("weddings");
  return weddings.map((w) => ({ params: { slug: w.data.slug }, props: { data: w.data } }));
}
const { data } = Astro.props;
---

<Base title={`Buku Doa — ${data.couple.nick[0]} & ${data.couple.nick[1]}`} theme={data.theme ?? "champagne"}>
  <div class="stars" aria-hidden="true"></div>
  <main class="book">
    <p class="kicker">Buku Doa Digital</p>
    <h1 class="book-title">{data.couple.nick[0]} & {data.couple.nick[1]}</h1>
    <p class="book-count" id="book-count">memuat doa…</p>
    <button class="btn" id="csv" type="button">Unduh CSV</button>
    <ul class="book-list" id="book-list"></ul>
  </main>
</Base>

<script>
  import { loadWishes, onNewWish } from "../../scripts/wishes";

  const slug = window.location.pathname.split("/")[1];
  const list = document.getElementById("book-list")!;
  const count = document.getElementById("book-count")!;
  let all: { nama: string; pesan: string; created_at?: string }[] = [];

  const fmt = (iso?: string) =>
    iso ? new Date(iso).toLocaleString("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";

  function row(w: { nama: string; pesan: string; created_at?: string }) {
    const li = document.createElement("li");
    const p = document.createElement("p");
    p.textContent = `“${w.pesan}”`;
    const s = document.createElement("span");
    s.textContent = `${w.nama || "Tanpa nama"} · ${fmt(w.created_at)}`;
    li.append(p, s);
    return li;
  }

  (async () => {
    all = await loadWishes(slug);
    count.textContent = `${all.length} doa terkumpul`;
    [...all].reverse().forEach((w) => list.appendChild(row(w)));
    onNewWish(slug, (w) => {
      all.push(w);
      count.textContent = `${all.length} doa terkumpul`;
      list.prepend(row(w));
    });
  })();

  document.getElementById("csv")!.addEventListener("click", () => {
    const esc = (t: string) => `"${t.replace(/"/g, '""')}"`;
    const csv = [
      "nama,pesan,waktu",
      ...all.map((w) => [esc(w.nama), esc(w.pesan), esc(w.created_at ?? "")].join(",")),
    ].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
    a.download = `doa-${slug}.csv`;
    a.click();
  });
</script>

<style>
  .book {
    max-width: 720px;
    margin-inline: auto;
    padding: 5rem 1.5rem;
    display: flex; flex-direction: column;
    align-items: center; gap: 1.2rem;
    text-align: center;
  }
  .book-title {
    font-family: var(--font-display);
    font-style: italic; font-weight: 300;
    font-size: var(--step-3);
  }
  .book-count {
    font-family: var(--font-mono);
    letter-spacing: 0.25em; text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--gold);
  }
  .book-list {
    list-style: none;
    margin-top: 2rem;
    display: flex; flex-direction: column; gap: 1.4rem;
    width: 100%;
  }
  .book-list p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .book-list span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--ivory-dim);
  }
</style>