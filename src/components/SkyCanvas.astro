---
import type { SkyConfig } from "../three/sky";

interface Props {
  config: SkyConfig;
}
const { config } = Astro.props;
---

<canvas
  id="sky"
  aria-hidden="true"
  data-config={JSON.stringify(config)}
></canvas>

<script>
  import { initSky } from "../three/sky";
  const canvas = document.getElementById("sky");
  if (canvas instanceof HTMLCanvasElement) {
    const cfg = JSON.parse(canvas.dataset.config!);
    initSky(canvas, cfg);
  }
</script>

<style>
  #sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.8s var(--ease-lux);
  }
  #sky.ready { opacity: 1; }
</style>