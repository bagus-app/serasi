---
interface Props {
  gallery: { src: string; alt: string }[];
}
const { gallery } = Astro.props;
---

<section class="gallery" id="galeri">
  <p class="kicker rv">Galeri</p>
  <h2 class="gallery-title rv"><span class="mask"><span>Wajah di Balik Bintang</span></span></h2>
  <div class="gallery-grid">
    {
      gallery.map((g) => (
        <figure class="g-item rv">
          <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .gallery {
    min-height: 100svh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
  }
  .gallery-title {
    font-family: var(--font-display);
    font-style: italic; font-weight: 400;
    font-size: var(--step-3);
    margin: 0.5rem 0 2.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    width: min(100%, 760px);
  }
  /* Foto pertama lebar — ritme editorial */
  @media (min-width: 640px) {
    .g-item:first-child { grid-column: span 2; }
  }
  .g-item {
    overflow: hidden;
    border-radius: 200px 200px 12px 12px;
    border: 1px solid var(--hair);
    aspect-ratio: 3 / 4;
    margin: 0;
  }
  .g-item:first-child { aspect-ratio: 16 / 10; }

  /* "Bernapas" — terlihat di HP maupun desktop (tanpa hover) */
  .g-item img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    animation: kenburns 16s var(--ease-lux) infinite alternate;
  }
  .g-item:nth-child(2) img { animation-delay: -4s; }
  .g-item:nth-child(3) img { animation-delay: -8s; }
  .g-item:nth-child(4) img { animation-delay: -12s; }
  @keyframes kenburns {
    from { transform: scale(1.02); }
    to { transform: scale(1.1); }
  }
</style>