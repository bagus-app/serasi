---
interface Props {
  gallery: { src: string; alt: string }[];
}
const { gallery } = Astro.props;
---

<section class="gallery" id="galeri">
  <p class="kicker rv">Galeri</p>
  <h2 class="gallery-title rv"><span class="mask"><span>Wajah di Balik Bintang</span></span></h2>
  <div class="gallery-grid">
    {
      gallery.map((g) => (
        <figure class="g-item rv">
          <button class="g-btn" type="button" data-full={g.src} aria-label={`Perbesar foto: ${g.alt}`}>
            <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
          </button>
        </figure>
      ))
    }
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" type="button" aria-label="Tutup">×</button>
    <img class="lb-img" alt="" />
  </div>
</section>

<script>
  const lb = document.getElementById("lightbox");
  const lbImg = lb?.querySelector(".lb-img") as HTMLImageElement | null;

  document.querySelectorAll<HTMLButtonElement>(".g-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!lb || !lbImg) return;
      lbImg.src = btn.dataset.full!;
      lb.hidden = false;
      document.body.style.overflow = "hidden";
    });
  });

  lb?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest(".lb-img")) return;
    lb.hidden = true;
    document.body.style.overflow = "";
  });
</script>

<style>
  .gallery {
    min-height: 100svh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
  }
  .gallery-title {
    font-family: var(--font-display);
    font-style: italic; font-weight: 400;
    font-size: var(--step-3);
    margin: 0.5rem 0 2.5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    width: min(100%, 760px);
  }
  @media (min-width: 640px) {
    .g-item:first-child { grid-column: span 2; }
  }
  .g-item {
    overflow: hidden;
    border-radius: 200px 200px 12px 12px;
    border: 1px solid var(--hair);
    aspect-ratio: 3 / 4;
    margin: 0;
  }
  .g-item:first-child { aspect-ratio: 16 / 10; }
  .g-btn {
    all: unset;
    display: block; width: 100%; height: 100%;
    cursor: zoom-in;
  }
  .g-btn img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    animation: kenburns 16s var(--ease-lux) infinite alternate;
  }
  .g-item:nth-child(2) img { animation-delay: -4s; }
  .g-item:nth-child(3) img { animation-delay: -8s; }
  .g-item:nth-child(4) img { animation-delay: -12s; }
  @keyframes kenburns {
    from { transform: scale(1.02); }
    to { transform: scale(1.1); }
  }

  /* — Lightbox — */
  .lightbox {
    position: fixed; inset: 0;
    z-index: 110;
    background: rgba(10, 8, 16, 0.92);
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
  }
  .lightbox[hidden] { display: none; }
  .lb-img {
    max-width: 100%; max-height: 88svh;
    border-radius: 12px;
    border: 1px solid var(--hair);
  }
  .lb-close {
    position: absolute; top: 1rem; right: 1rem;
    width: 48px; height: 48px;
    border-radius: 50%;
    border: 1px solid var(--hair);
    background: rgba(18, 14, 30, 0.6);
    color: var(--gold-bright);
    font-size: 1.4rem;
    cursor: pointer;
  }
</style>