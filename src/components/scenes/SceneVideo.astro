---
interface Props {
  video: { youtubeId: string; caption?: string };
}
const { video } = Astro.props;
const posterHQ = `https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`;
const posterSD = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;
---

<section class="video" id="video">
  <button class="video-facade rv" type="button" data-yt={video.youtubeId} aria-label="Putar video">
    <img src={posterHQ} data-fallback={posterSD} alt="Video prewedding" loading="lazy" />
    <span class="play" aria-hidden="true">▶</span>
  </button>
  {video.caption && <p class="video-caption rv">{video.caption}</p>}
</section>

<script>
  // Poster: coba HD, turun ke SD bila tidak ada
  document.querySelectorAll<HTMLImageElement>(".video-facade img").forEach((img) => {
    img.addEventListener("error", () => {
      if (img.src !== img.dataset.fallback) img.src = img.dataset.fallback!;
    }, { once: true });
  });

  document.querySelectorAll<HTMLButtonElement>(".video-facade").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.yt!;
      const wrap = document.createElement("div");
      wrap.className = "video-embed";
      wrap.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="Video prewedding" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      btn.replaceWith(wrap);
    });
  });
</script>

<style>
  .video {
    display: flex; flex-direction: column;
    align-items: center;
    padding: 2rem 1.5rem 4rem;
  }
  .video-facade {
    position: relative;
    width: min(100%, 760px);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hair);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    background: none; padding: 0;
  }
  .video-facade img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    filter: brightness(0.7);
  }
  .play {
    position: absolute; top: 50%; left: 50%;
    translate: -50% -50%;
    width: 72px; height: 72px;
    border-radius: 50%;
    border: 1px solid var(--gold-bright);
    color: var(--gold-bright);
    display: grid; place-items: center;
    font-size: 1.2rem;
    background: rgba(13, 10, 20, 0.5);
    transition: transform 0.4s var(--ease-lux), background 0.4s;
  }
  .video-facade:hover .play { transform: scale(1.1); background: rgba(201, 163, 106, 0.25); }
  .video-caption {
    margin-top: 1rem;
    color: var(--ivory-dim);
    font-style: italic;
    font-family: var(--font-display);
  }
  :global(.video-embed) {
    width: min(100%, 760px);
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--hair);
  }
  :global(.video-embed iframe) {
    width: 100%; height: 100%;
    display: block; border: 0;
  }
</style>